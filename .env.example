# Copy to .env.local for local work. Never commit .env.local.
# On Cloud Run these are set on the service by the deploy workflows.

# "production" makes the site public and indexable. Anything else is treated
# as development: sign-in required, banner shown, search engines told to stay away.
SITE_ENV=development

# Public address of this site, used in the sitemap and robots.txt.
SITE_URL=http://localhost:3000

# Shown by /api/health. The deploy workflows set this to the commit or tag.
APP_VERSION=local

# Development-site sign-in. Required unless SITE_ENV=production.
# Local example values only. Use different values on any deployed site.
DEV_AUTH_USER=preview
DEV_AUTH_PASSWORD=local-only-change-me

# Contact form inboxes. CONTACT_TO_GENERAL is required; the others fall back to it.
CONTACT_TO_GENERAL=hello@example.com
CONTACT_TO_SALES=
CONTACT_TO_CAREERS=careers@example.com
CONTACT_TO_SUPPORT=

# Mail. Leave SMTP_HOST empty for dry-run mode: nothing is sent and the
# response says which inbox the message would have gone to.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=website@example.com
